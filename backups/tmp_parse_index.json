{
  "sections": {
    "kojin_drop": {
      "type": "kojin-drop",
      "blocks": {
        "tee_1": {
          "type": "mockup",
          "settings": {
            "title": "Team Wordmark Tee",
            "mockup": "shopify://shop_images/kojin-racers-kr-01.jpg"
          }
        },
        "tee_2": {
          "type": "mockup",
          "settings": {
            "title": "Night Session Tee",
            "mockup": "shopify://shop_images/kojin-racers-kr-02.jpg"
          }
        },
        "tee_3": {
          "type": "mockup",
          "settings": {
            "title": "Garage Crew Tee",
            "mockup": "shopify://shop_images/kojin-racers-kr-03.jpg"
          }
        }
      },
      "block_order": [
        "tee_1",
        "tee_2",
        "tee_3"
      ],
      "settings": {
        "tees": "kojin-racers-tees",
        "gear": "garage-gear"
      }
    },
    "kojin_crew_signup": {
      "type": "section",
      "blocks": {
        "heading": {
          "type": "text",
          "name": "Heading",
          "settings": {
            "text": "<h2>Join the Kojin Crew \u2014 10% off your first order</h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h3",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blurb": {
          "type": "text",
          "settings": {
            "text": "<p>Drop alerts, garage notes, and code <strong>WELCOME10</strong> for 10% off your first order. One use per customer.</p>",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "email_signup": {
          "type": "email-signup",
          "settings": {
            "width": "custom",
            "custom_width": 50,
            "heading": "",
            "heading_preset": "h3",
            "border_style": "all",
            "input_style": "default",
            "style_class": "button",
            "display_type": "text",
            "label": "Join the crew",
            "integrated_button": true,
            "button_type_preset": "paragraph",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading",
        "blurb",
        "email_signup"
      ],
      "name": "Kojin Crew signup",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "section_height_custom": 50,
        "background_media": "none",
        "background_color": "{{ settings.color_palette.background }}",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 48,
        "padding-block-end": 64
      }
    },
    "kojin_mechanic": {
      "type": "media-with-content",
      "name": "Shop & Mobile Mechanic",
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "image": "shopify://shop_images/kojin-racers-shop-mobile-mechanic-ad.png",
            "link": "/pages/mechanic",
            "image_position": "cover"
          },
          "blocks": {}
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 20
          },
          "blocks": {
            "kicker": {
              "type": "text",
              "name": "Kicker",
              "settings": {
                "text": "<p>03 / SERVICES</p>",
                "type_preset": "h6",
                "text_color": "#f55738"
              },
              "blocks": {}
            },
            "heading": {
              "type": "text",
              "name": "Heading",
              "settings": {
                "text": "<h2>Shop &amp; Mobile Mechanic</h2>",
                "type_preset": "h2",
                "text_color": "#f2e9d7"
              },
              "blocks": {}
            },
            "blurb": {
              "type": "text",
              "name": "Blurb",
              "settings": {
                "text": "<p>Brakes, suspension, oil changes, diagnostics and select engine repairs, in our shop or at your driveway. Serving Renton, Kent and Greater Seattle.</p>",
                "type_preset": "rte",
                "max_width": "narrow",
                "text_color": "#dfd5c6"
              },
              "blocks": {}
            },
            "buttons": {
              "type": "group",
              "name": "Buttons",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": false,
                "horizontal_alignment": "flex-start",
                "gap": 10,
                "width": "fill",
                "width_mobile": "fill"
              },
              "blocks": {
                "book": {
                  "type": "button",
                  "name": "Book Service",
                  "settings": {
                    "label": "Book Service",
                    "link": "/pages/mechanic",
                    "style_class": "button-custom",
                    "custom_button_background": "#f55738",
                    "custom_button_text": "#171717",
                    "custom_button_border": "#f55738"
                  },
                  "blocks": {}
                },
                "text": {
                  "type": "custom-liquid",
                  "name": "Text Us",
                  "settings": {
                    "custom_liquid": "<a class=\"button button-secondary\" href=\"sms:+12066737672\">Text Us</a>"
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "book",
                "text"
              ]
            }
          },
          "block_order": [
            "kicker",
            "heading",
            "blurb",
            "buttons"
          ]
        }
      },
      "settings": {
        "media_position": "left",
        "media_width": "medium",
        "media_height": "auto",
        "section_width": "page-width",
        "extend_media": false,
        "background_color": "#181819",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    }
  },
  "order": [
    "kojin_drop",
    "kojin_mechanic",
    "kojin_crew_signup"
  ]
}